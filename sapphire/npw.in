&CONTROL
   calculation      = 'scf'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   nstep            = 1
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out2/'
   prefix           = 'int'
   max_seconds      = 165600
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
  ibrav = 0,
  nat = 10,
  ntyp = 2,
  ecutwfc = 60,
  ecutrho = 385,
  occupations = 'smearing',
  smearing = 'gauss',
  degauss = 0.02,
  tot_charge = 0,
/
&ELECTRONS
   electron_maxstep = 500
   conv_thr         = 1e-9
   mixing_mode      = 'plain'
   mixing_beta      = 0.3
   mixing_ndim      = 24
   diagonalization  = 'david'
   diago_david_ndim = 4
   diago_full_acc   = .false.
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
/

