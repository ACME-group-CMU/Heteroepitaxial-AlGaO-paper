#!/bin/bash

#SBATCH --partition=batch
#SBATCH --job-name=sqs_am25.0
#SBATCH -o %x_%j.out
#SBATCH --exclude=trace[25-28]
#SBATCH -e %x_%j.err
#SBATCH --ntasks=1
#SBATCH --mem=15625
#SBATCH --time=48:00:00
#SBATCH --mail-user=posent@andrew.cmu.edu
#SBATCH --mail-type=BEGIN,END,FAIL,REQUEUE

export OMP_NUM_THREADS=1
export PATH=/trace/home/posent/atat/bin:$PATH

corrdump -l=rndstr.in -ro -noe -nop -clus -2=6 -3=5.2 -4=5.2
wait
mcsqs -n=120 -rc
    