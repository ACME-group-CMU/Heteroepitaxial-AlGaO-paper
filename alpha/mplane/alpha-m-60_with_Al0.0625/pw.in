   conv_thr         = 1e-7
   mixing_mode      = 'plain'
   mixing_beta      = 0.3
   mixing_ndim      = 24
   diagonalization  = 'david'
   diago_david_ndim = 4
   diago_full_acc   = .false.
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  cell_dofree = 'epitaxial_ab',
/

