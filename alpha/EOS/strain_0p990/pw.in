&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'high'
   restart_mode     = 'restart'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out/'
   prefix           = 'int'
   max_seconds      = 124200
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
   ntyp             = 2
   nat              = 30
   tot_charge       = 0
   ecutwfc          = 105
   ecutrho          = 412
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gauss'
   ibrav            = 0
/
&ELECTRONS
