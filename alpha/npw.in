&CONTROL
   calculation      = 'scf'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   nstep            = 1
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out/'
   prefix           = 'int'
   max_seconds      = 82800
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
   ntyp             = 2
   nat              = 30
   tot_charge       = 0
   ecutwfc          = 60
   ecutrho          = 385
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gauss'
   ibrav            = 0
/
&ELECTRONS
