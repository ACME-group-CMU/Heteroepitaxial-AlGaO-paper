&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out/'
   prefix           = 'int'
   max_seconds      = 165600
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
  ibrav = 0,
  nat = 120,
  ntyp = 3,
  ecutwfc = 60,
  ecutrho = 385,
  occupations = 'smearing',
  smearing = 'gauss',
  degauss = 0.02,
  tot_charge = 0,
/
&ELECTRONS
   electron_maxstep = 500
   conv_thr         = 1e-7
   mixing_mode      = 'plain'
   mixing_beta      = 0.3
   mixing_ndim      = 24
   diagonalization  = 'david'
   diago_david_ndim = 4
   diago_full_acc   = .false.
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  cell_dofree = 'epitaxial_ab',
/

