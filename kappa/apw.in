&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out4/'
   prefix           = 'int'
   max_seconds      = 155600
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
   ntyp             = 2
   nat              = 40
   tot_charge       = 0
   ecutwfc          = 60
   ecutrho          = 385
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gauss'
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 500
   conv_thr         = 1e-7
   mixing_mode      = 'plain'
   mixing_beta      = 0.3
   mixing_ndim      = 24
   diagonalization  = 'david'
   diago_david_ndim = 4
   diago_full_acc   = .false.
/
&IONS
   ion_dynamics     = 'bfgs'

/
&CELL
   cell_dynamics    = 'bfgs'
/
&FCP
/
&RISM
/
