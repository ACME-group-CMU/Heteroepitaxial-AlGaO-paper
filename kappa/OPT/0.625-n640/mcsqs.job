#!/bin/bash

#SBATCH --partition=acmegroup
#SBATCH --job-name=sqs_62.5-640
#SBATCH -o %x_%j.out
#SBATCH --exclude=trace[25-28]
#SBATCH -e %x_%j.err
#SBATCH --ntasks=1
#SBATCH --mem=15625
#SBATCH --time=48:00:00
#SBATCH --mail-user=posent@andrew.cmu.edu
#SBATCH --mail-type=BEGIN,END,FAIL,REQUEUE

export OMP_NUM_THREADS=1
export PATH=/trace/home/posent/atat/bin:$PATH

corrdump -l=rndstr.in -ro -noe -nop -clus -2=12 -3=10.4 -4=10.4
wait
mcsqs -n=640 -rc
    
