&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './out/'
   prefix           = 'int'
   max_seconds      = 124200
   disk_io          = 'low'
   pseudo_dir       = '/trace/group/acmegroup/posen/pseudopotential'
/
&SYSTEM
   ntyp             = 2
   nat              = 20
   tot_charge       = 0
   ecutwfc          = 105
   ecutrho          = 412
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gauss'
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-8
   mixing_mode      = 'plain'
   mixing_beta      = 0.3
   mixing_ndim      = 24
   diagonalization  = 'david'
   diago_david_ndim = 4
   diago_full_acc   = .false.
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   cell_dofree      = 'shape',
/
&FCP
/
&RISM
/
